<%- include("partials/header", { title: "Archer" }) %>
<h1>Archer Information</h1>
<form class="card card-body col-md-6" method="post" action="/archer">
  <div class="mb-3">
    <label class="form-label" for="archerId">Archer ID</label>
    <input class="form-control" type="number" name="archerId" id="archerId" min="1" required value="<%= typeof archerId !== 'undefined' ? archerId : '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label" for="competitionId">Competition</label>
    <select class="form-select" name="competitionId" id="competitionId" required>
      <option value="">Choose a competition</option>
      <% competitions.forEach((competition) => { %>
        <option value="<%= competition.id %>" <%= String(competition.id) === selectedCompetitionId ? "selected" : "" %>><%= competition.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-primary" type="submit">Proceed</button>
    <button class="btn btn-secondary" type="reset">Reset</button>
  </div>
</form>

<% if (error) { %>
  <div class="alert alert-warning mt-4" role="alert"><%= error %></div>
<% } %>

<% if (archer) { %>
  <section class="card card-body mt-4" aria-labelledby="archerDetailsHeading">
    <h2 id="archerDetailsHeading" class="h4">Archer details</h2>
    <dl class="row mb-0">
      <dt class="col-sm-4">Archer ID</dt><dd class="col-sm-8"><%= archer.id %></dd>
      <dt class="col-sm-4">Name</dt><dd class="col-sm-8"><%= archer.name %></dd>
      <dt class="col-sm-4">Gender</dt><dd class="col-sm-8"><%= archer.gender %></dd>
      <dt class="col-sm-4">Date of birth</dt><dd class="col-sm-8"><%= archer.dateOfBirth %></dd>
      <dt class="col-sm-4">Category</dt><dd class="col-sm-8"><%= archer.categoryName %></dd>
      <dt class="col-sm-4">Division</dt><dd class="col-sm-8"><%= archer.divisionName %></dd>
      <dt class="col-sm-4">Class</dt><dd class="col-sm-8"><%= archer.className %></dd>
      <dt class="col-sm-4">Round</dt><dd class="col-sm-8"><%= archer.roundName %></dd>
      <dt class="col-sm-4">Possible score</dt><dd class="col-sm-8"><%= archer.possibleScore %></dd>
      <dt class="col-sm-4">Round date</dt><dd class="col-sm-8"><%= archer.roundDate || "Not scheduled" %></dd>
    </dl>
  </section>
<% } %>
<%- include("partials/footer") %>
